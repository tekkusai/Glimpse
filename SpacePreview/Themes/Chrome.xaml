<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:u="clr-namespace:SpacePreview.Utilities">
    <!-- One control vocabulary for the preview header and every dialog
         (merged in App.OnStartup, like Menus.xaml): a 30 px square icon
         button and a 30 px capsule. Hover and press tint with HoverBg and
         PressedBg on every surface; only a disabled control dims.
         docs/DESIGN.md, Shape and Header. -->

    <!-- A Segoe Fluent glyph in a 30 x 30 square. Toggles reuse it. -->
    <Style x:Key="IconButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Tint" CornerRadius="{x:Static u:Metrics.IconCorner}" Background="Transparent">
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On is the accent, the pin convention everywhere. -->
    <Style x:Key="IconToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The capsule: a label, optionally led by an icon. -->
    <Style x:Key="Pill" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.RaisedBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.RaisedBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="{x:Static u:Metrics.FontLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static u:Metrics.PillCorner}">
                        <Border x:Name="Tint"
                                CornerRadius="{x:Static u:Metrics.PillInnerCorner}"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The surface's one commit action. -->
    <Style x:Key="AccentPill" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- A quiet way out. -->
    <Style x:Key="QuietPill" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
    </Style>

    <!-- A pill that holds a choice: checked wears the accent edge. -->
    <Style x:Key="ChoicePill" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A split pill is a frame of segments. Each segment tints an inset
         capsule, so first, middle and last share one template. -->
    <Style x:Key="PillFrame" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.RaisedBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.RaisedBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{x:Static u:Metrics.PillCorner}" />
    </Style>

    <Style x:Key="PillSegment" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="{x:Static u:Metrics.FontLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Tint"
                            Margin="2"
                            CornerRadius="{x:Static u:Metrics.SegmentCorner}"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Face" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillGlyphSegment" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource PillSegment}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Dialogs wear the preview's frame (see WindowFrame): DWM corners,
         border and shadow, never a drawn card. -->
    <Style x:Key="DialogWindow" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="Background" Value="{DynamicResource Theme.ChromeBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="0"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              NonClientFrameEdges="None"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The switch. The thumb slides rather than teleports; accent means on. -->
    <Style x:Key="HouseToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Switch">
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.RaisedBg}"
                                BorderBrush="{DynamicResource Theme.RaisedBorder}"
                                BorderThickness="1" />
                        <Border x:Name="Tint" CornerRadius="10" Background="Transparent" />
                        <Ellipse x:Name="Thumb"
                                 Width="14"
                                 Height="14"
                                 Margin="3,0"
                                 HorizontalAlignment="Left"
                                 Fill="{DynamicResource Theme.TextTertiary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbSlide" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="20"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Switch" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet inline action: reads as text, behaves as a button. -->
    <Style x:Key="LinkButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
        <Setter Property="FontSize" Value="{x:Static u:Metrics.FontCaption}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Tint"
                            Background="Transparent"
                            CornerRadius="{x:Static u:Metrics.RowCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
