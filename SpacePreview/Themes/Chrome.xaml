<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:u="clr-namespace:SpacePreview.Utilities">
    <!-- Dialog chrome shared by the settings, update, and notification windows
         (merged in App.OnStartup, like Menus.xaml). One vocabulary: the same
         card, the same close button, the same controls, so no window can
         drift back to native-looking fallbacks. -->

    <!-- The close affordance every dialog shares: the same Fluent glyph and
         corner treatment as the preview header's icon buttons, centered by
         the glyph font instead of a text-baseline hack. -->
    <Style x:Key="DialogCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
        <Setter Property="Content" Value="&#xE8BB;" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="{x:Static u:Metrics.IconCorner}"
                            Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog action buttons, extracted from the update window so every
         dialog resolves the same pair. Hover and press dim the whole chrome,
         which keeps the accent primary its own color. -->
    <Style x:Key="DialogButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.SurfaceBorder}" />
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static u:Metrics.MenuCorner}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.68" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogPrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DialogButton}">
        <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The switch. The thumb slides rather than teleports; accent means on,
         matching the pin convention everywhere else in the app. -->
    <Style x:Key="HouseToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Track"
                            CornerRadius="10"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            BorderBrush="{DynamicResource Theme.SurfaceBorder}"
                            BorderThickness="1">
                        <Ellipse x:Name="Thumb"
                                 Width="14"
                                 Height="14"
                                 Margin="2,0"
                                 HorizontalAlignment="Left"
                                 Fill="{DynamicResource Theme.TextTertiary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbSlide" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="20"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet inline action: reads as text, behaves as a button. -->
    <Style x:Key="LinkButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{x:Static u:Metrics.RowCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.PressedBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
