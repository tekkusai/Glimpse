<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:u="clr-namespace:SpacePreview.Utilities">
    <!-- The tray menu, the Open menu and the preview's right-click menu share
         one look (merged at application level in App.OnStartup). -->

    <!-- Menu item: a leading check column (shown when IsChecked and it is a leaf),
         the header, and a trailing chevron plus flyout for submenu items. One
         template serves both leaf checkables and the "Theme" parent. -->
    <Style x:Key="PreviewMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Chrome"
                            CornerRadius="{x:Static u:Metrics.RowCorner}"
                            Padding="{x:Static u:Metrics.MenuItemPadding}"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- The check gutter only exists for checkable items:
                                     action menus (Open flyout, right-click) sit flush left. -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Check"
                                       Grid.Column="0"
                                       Width="20"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       TextAlignment="Left"
                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="{x:Static u:Metrics.FontBody}"
                                              TextElement.Foreground="{DynamicResource Theme.TextPrimary}" />

                            <TextBlock x:Name="Chevron"
                                       Grid.Column="2"
                                       Margin="16,0,0,0"
                                       Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       Visibility="Collapsed" />

                            <Popup x:Name="SubMenuPopup"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   VerticalOffset="-6"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Theme.ChromeBg}"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{x:Static u:Metrics.MenuCorner}"
                                        Padding="{x:Static u:Metrics.MenuPadding}"
                                        Margin="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                        </Trigger>
                        <!-- Parent items (a submenu) show a chevron; leaf checkables show the tick. -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Checkable-but-unchecked reserves the gutter so siblings align. -->
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="HasItems" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreviewContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource Theme.ChromeBg}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1"
                            CornerRadius="{x:Static u:Metrics.MenuCorner}"
                            Padding="{x:Static u:Metrics.MenuPadding}">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tray menu's separator, themed to the palette's border colour. -->
    <Style x:Key="PreviewMenuSeparator" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="6,5,6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Background="{DynamicResource Theme.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips share the flyout surface style: themed and rounded.
         Implicit at application level so every tooltip in the app follows the
         theme instead of the system default. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="{x:Static u:Metrics.FontCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Margin="6"
                            Padding="10,6,10,7"
                            Background="{DynamicResource Theme.ChromeBg}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1"
                            CornerRadius="{x:Static u:Metrics.MenuCorner}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3" Color="#000000" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
