<Window x:Class="SpacePreview.Services.PreviewAccessWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse notification"
        Width="388"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Border x:Name="Chrome"
                Background="{DynamicResource Theme.HeaderBg}"
                BorderBrush="{DynamicResource Theme.SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  ShadowDepth="4"
                                  Opacity="0.30"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar"
                        Grid.Column="0"
                        Margin="0,15,0,15"
                        CornerRadius="0,3,3,0" />

                <StackPanel Grid.Column="1" Margin="16,14,8,15">
                    <TextBlock Text="Preview unavailable"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="BodyText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Glimpse · closes automatically"
                               Margin="0,9,0,0"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               FontSize="11.5" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="0,8,6,0"
                        VerticalAlignment="Top"
                        Focusable="False"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss notification"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Theme.TextSecondary}"
                        FontFamily="Segoe UI Variable, Segoe UI"
                        FontSize="18"
                        Content="×">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,-2,0,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome"
                                            Property="Background"
                                            Value="{DynamicResource Theme.HoverBg}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome"
                                            Property="Background"
                                            Value="{DynamicResource Theme.PressedBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
