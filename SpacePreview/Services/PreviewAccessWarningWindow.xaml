<Window x:Class="SpacePreview.Services.PreviewAccessWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Style="{StaticResource DialogWindow}"
        Width="380"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="AccentBar"
                Grid.Column="0"
                Margin="0,16,0,16"
                CornerRadius="0,2,2,0"
                Background="{DynamicResource Theme.Accent}" />

        <StackPanel Grid.Column="1" Margin="16,14,4,16">
            <TextBlock x:Name="HeadingText"
                       FontSize="{x:Static u:Metrics.FontName}"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="BodyText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       FontSize="{x:Static u:Metrics.FontBody}"
                       LineHeight="19"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FooterText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Theme.TextTertiary}"
                       FontSize="{x:Static u:Metrics.FontCaption}"
                       LineHeight="17"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Button x:Name="CloseButton"
                Grid.Column="2"
                Margin="0,8,8,0"
                VerticalAlignment="Top"
                Style="{StaticResource IconButton}"
                Content="&#xE8BB;"
                ToolTip="Dismiss"
                AutomationProperties.Name="Dismiss notification" />
    </Grid>
</Window>
