<Window x:Class="SpacePreview.Services.PreviewAccessWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Title="Glimpse notification"
        Width="388"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Border x:Name="Chrome"
                Background="{DynamicResource Theme.ChromeBg}"
                BorderBrush="{DynamicResource Theme.RaisedBorder}"
                BorderThickness="1"
                CornerRadius="{x:Static u:Metrics.PillCorner}"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  ShadowDepth="4"
                                  Opacity="0.30"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar"
                        Grid.Column="0"
                        Margin="0,15,0,15"
                        CornerRadius="0,3,3,0" />

                <StackPanel Grid.Column="1" Margin="16,14,8,15">
                    <TextBlock x:Name="HeadingText"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="BodyText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="FooterText"
                               Margin="0,9,0,0"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               FontSize="11.5"
                               LineHeight="17"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Margin="0,7,4,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource DialogCloseButton}"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss notification" />
            </Grid>
        </Border>
    </Grid>
</Window>
