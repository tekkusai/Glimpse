<Window x:Class="SpacePreview.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Style="{StaticResource DialogWindow}"
        Width="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False">
    <Window.Resources>
        <!-- A settings row: label left, control right, quiet hover so the
             whole row reads as one touch target when it is clickable. -->
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="{x:Static u:Metrics.RowCorner}" />
            <Setter Property="Margin" Value="-10,0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static u:Metrics.FontBody}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One segment of the theme picker; the checked chip lifts to the
             canvas. -->
        <Style x:Key="ThemeSegment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
            <Setter Property="FontSize" Value="{x:Static u:Metrics.FontCaption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                CornerRadius="{x:Static u:Metrics.RowCorner}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.CanvasBg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Theme.RaisedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,0,20,18">
        <Grid x:Name="TitleBar" Height="60" Background="Transparent">
            <TextBlock Text="Settings"
                       FontSize="{x:Static u:Metrics.FontTitle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,-8,0"
                    Style="{StaticResource IconButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    AutomationProperties.Name="Close settings" />
        </Grid>

        <Border x:Name="StartupRow" Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                <ToggleButton x:Name="StartupToggle"
                              Grid.Column="1"
                              Style="{StaticResource HouseToggle}"
                              AutomationProperties.Name="Start with Windows" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
                <Border Grid.Column="1"
                        Background="{DynamicResource Theme.RaisedBg}"
                        BorderBrush="{DynamicResource Theme.RaisedBorder}"
                        BorderThickness="1"
                        CornerRadius="{x:Static u:Metrics.MenuCorner}"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem"
                                     GroupName="Theme"
                                     Content="System"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Follow system theme" />
                        <RadioButton x:Name="ThemeLight"
                                     GroupName="Theme"
                                     Content="Light"
                                     Margin="2,0,0,0"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Light theme" />
                        <RadioButton x:Name="ThemeDark"
                                     GroupName="Theme"
                                     Content="Dark"
                                     Margin="2,0,0,0"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Dark theme" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- What this PC lacks, each with its one fix. Filled in a moment
             after the window opens; absent on a complete PC. Each optional
             section carries its own divider, so a missing one leaves no
             gap and no double line. -->
        <StackPanel x:Name="MissingPiecesSection" Visibility="Collapsed">
            <Border Style="{StaticResource Divider}" />
            <StackPanel x:Name="MissingPiecesList" />
        </StackPanel>

        <StackPanel x:Name="SignaturesSection" Visibility="Collapsed">
            <Border Style="{StaticResource Divider}" />
            <TextBlock x:Name="SignaturesHeading"
                       Margin="0,9,0,8"
                       Text="Saved signatures"
                       Style="{StaticResource RowLabel}" />
            <!-- Four tiles, then the list scrolls: the dialog never outgrows a small screen. -->
            <ScrollViewer MaxHeight="208"
                          Margin="0,0,0,5"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PreviewScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel x:Name="SignaturesList" />
            </ScrollViewer>
        </StackPanel>

        <Border Style="{StaticResource Divider}" />

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText"
                           VerticalAlignment="Center"
                           FontSize="{x:Static u:Metrics.FontLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextSecondary}" />
                <!-- One slot after the version: the quiet fact or the action. -->
                <TextBlock x:Name="UpToDateText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{x:Static u:Metrics.FontLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextTertiary}"
                           Text="Up to date"
                           Visibility="Collapsed" />
                <Button x:Name="UpdateLink"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        Style="{StaticResource LinkButton}"
                        FontSize="{x:Static u:Metrics.FontLabel}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Accent}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Install available update" />
            </StackPanel>
            <Button x:Name="CopyDiagnosticsButton"
                    Grid.Column="1"
                    Margin="0,0,-8,0"
                    Style="{StaticResource LinkButton}"
                    Content="Copy diagnostics"
                    AutomationProperties.Name="Copy diagnostics" />
        </Grid>
    </StackPanel>
</Window>
