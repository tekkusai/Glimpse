<Window x:Class="SpacePreview.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Style="{StaticResource DialogWindow}"
        Width="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False">
    <Window.Resources>
        <!-- A settings row: label left, control right, quiet hover so the
             whole row reads as one touch target when it is clickable. -->
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="{x:Static u:Metrics.RowCorner}" />
            <Setter Property="Margin" Value="-10,0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static u:Metrics.FontBody}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One segment of the theme picker; the checked chip lifts to the
             canvas. -->
        <Style x:Key="ThemeSegment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
            <Setter Property="FontSize" Value="{x:Static u:Metrics.FontCaption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                CornerRadius="{x:Static u:Metrics.RowCorner}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.CanvasBg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Theme.RaisedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,0,20,18">
        <Grid x:Name="TitleBar" Height="60" Background="Transparent">
            <TextBlock Text="Settings"
                       FontSize="{x:Static u:Metrics.FontTitle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,-8,0"
                    Style="{StaticResource IconButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    AutomationProperties.Name="Close settings" />
        </Grid>

        <Border x:Name="StartupRow" Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                <ToggleButton x:Name="StartupToggle"
                              Grid.Column="1"
                              Style="{StaticResource HouseToggle}"
                              AutomationProperties.Name="Start with Windows" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
                <Border Grid.Column="1"
                        Background="{DynamicResource Theme.RaisedBg}"
                        BorderBrush="{DynamicResource Theme.RaisedBorder}"
                        BorderThickness="1"
                        CornerRadius="{x:Static u:Metrics.MenuCorner}"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem"
                                     GroupName="Theme"
                                     Content="System"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Follow system theme" />
                        <RadioButton x:Name="ThemeLight"
                                     GroupName="Theme"
                                     Content="Light"
                                     Margin="2,0,0,0"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Light theme" />
                        <RadioButton x:Name="ThemeDark"
                                     GroupName="Theme"
                                     Content="Dark"
                                     Margin="2,0,0,0"
                                     Style="{StaticResource ThemeSegment}"
                                     AutomationProperties.Name="Dark theme" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="PinDefaultRow" Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pinned previews stay on top" Style="{StaticResource RowLabel}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="{x:Static u:Metrics.FontCaption}"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               TextWrapping="Wrap"
                               Text="You can change this on each pinned preview." />
                </StackPanel>
                <ToggleButton x:Name="PinDefaultToggle"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Style="{StaticResource HouseToggle}"
                              AutomationProperties.Name="Pinned previews stay on top" />
            </Grid>
        </Border>

        <Border Height="1"
                Margin="0,14,0,14"
                Background="{DynamicResource Theme.Border}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="VersionText"
                               VerticalAlignment="Center"
                               FontSize="{x:Static u:Metrics.FontLabel}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextSecondary}" />
                    <Button x:Name="UpdateLink"
                            Margin="6,0,0,0"
                            Padding="6,2"
                            Style="{StaticResource LinkButton}"
                            FontSize="{x:Static u:Metrics.FontLabel}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Theme.Accent}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Install available update" />
                </StackPanel>
                <TextBlock x:Name="DocumentsText"
                           Margin="0,3,0,0"
                           FontSize="{x:Static u:Metrics.FontCaption}"
                           Foreground="{DynamicResource Theme.TextTertiary}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="0,0,-8,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CopyDiagnosticsButton"
                        Style="{StaticResource LinkButton}"
                        Content="Copy diagnostics"
                        AutomationProperties.Name="Copy diagnostics" />
                <Button x:Name="OpenLogButton"
                        Style="{StaticResource LinkButton}"
                        Margin="2,0,0,0"
                        Content="Open log"
                        AutomationProperties.Name="Open log" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
