<Window x:Class="SpacePreview.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Title="Glimpse Settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- A settings row: label left, control right, quiet hover so the
             whole row reads as one touch target when it is clickable. -->
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="{x:Static u:Metrics.RowCorner}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiary}" />
            <Setter Property="Margin" Value="10,20,10,6" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>

        <!-- One segment of the theme picker; the checked chip lifts to the
             window surface. -->
        <Style x:Key="ThemeSegment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                CornerRadius="{x:Static u:Metrics.RowCorner}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="9,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Theme.CanvasBg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Theme.RaisedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{DynamicResource Theme.ChromeBg}"
                BorderBrush="{DynamicResource Theme.RaisedBorder}"
                BorderThickness="1"
                CornerRadius="{x:Static u:Metrics.CardCorner}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.34"
                                  Color="#000000" />
            </Border.Effect>

            <StackPanel Margin="16,18,16,18">
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Margin="12,-4,-4,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource DialogCloseButton}"
                            AutomationProperties.Name="Close settings" />
                </Grid>

                <TextBlock Text="General" Style="{StaticResource SectionLabel}" />

                <Border x:Name="StartupRow"
                        Style="{StaticResource SettingsRow}"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="StartupToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource HouseToggle}"
                                      AutomationProperties.Name="Start with Windows" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource Theme.RaisedBg}"
                                BorderBrush="{DynamicResource Theme.RaisedBorder}"
                                BorderThickness="1"
                                CornerRadius="{x:Static u:Metrics.MenuCorner}"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem"
                                             GroupName="Theme"
                                             Content="System"
                                             Style="{StaticResource ThemeSegment}"
                                             AutomationProperties.Name="Follow system theme" />
                                <RadioButton x:Name="ThemeLight"
                                             GroupName="Theme"
                                             Content="Light"
                                             Margin="2,0,0,0"
                                             Style="{StaticResource ThemeSegment}"
                                             AutomationProperties.Name="Light theme" />
                                <RadioButton x:Name="ThemeDark"
                                             GroupName="Theme"
                                             Content="Dark"
                                             Margin="2,0,0,0"
                                             Style="{StaticResource ThemeSegment}"
                                             AutomationProperties.Name="Dark theme" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PinDefaultRow"
                        Style="{StaticResource SettingsRow}"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pinned previews stay on top" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="PinDefaultToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource HouseToggle}"
                                      AutomationProperties.Name="Pinned previews stay on top" />
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource RowCaption}"
                           Text="You can change this on each pinned preview." />

                <Border Height="1"
                        Margin="10,22,10,0"
                        Background="{DynamicResource Theme.RaisedBorder}" />

                <Grid Margin="10,16,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextSecondary}" />
                        <TextBlock x:Name="UpdateLink"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Theme.Accent}"
                                   AutomationProperties.Name="Install available update" />
                        <TextBlock x:Name="DocumentsText"
                                   Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.TextTertiary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="CopyDiagnosticsButton"
                                Style="{StaticResource LinkButton}"
                                Content="Copy diagnostics"
                                AutomationProperties.Name="Copy diagnostics" />
                        <Button x:Name="OpenLogButton"
                                Style="{StaticResource LinkButton}"
                                Margin="4,0,0,0"
                                Content="Open log"
                                AutomationProperties.Name="Open log" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
