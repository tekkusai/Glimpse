<Window x:Class="SpacePreview.Services.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Title="Update Glimpse"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- Buttons and the close affordance come from Themes/Chrome.xaml: one
         dialog vocabulary across settings, update, and notifications. -->

    <Grid Margin="14">
        <Border Background="{DynamicResource Theme.HeaderBg}"
                BorderBrush="{DynamicResource Theme.SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="{x:Static u:Metrics.CardCorner}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.34"
                                  Color="#000000" />
            </Border.Effect>

            <Grid Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Update Glimpse"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Margin="12,-6,-8,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource DialogCloseButton}"
                            AutomationProperties.Name="Close update" />
                </Grid>

                <TextBlock x:Name="VersionText"
                           Grid.Row="1"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource Theme.TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="BodyText"
                           Grid.Row="2"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           FontSize="13"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Text="Glimpse will download and verify the update, then close briefly while setup finishes." />

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="5"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"
                                 Foreground="{DynamicResource Theme.Accent}"
                                 Background="{DynamicResource Theme.SurfaceBg}"
                                 AutomationProperties.Name="Update download progress"
                                 BorderThickness="0" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               FontSize="11.5"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="SecondaryButton"
                            MinWidth="88"
                            Style="{StaticResource DialogButton}"
                            Content="Not now"
                            AutomationProperties.Name="Not now" />
                    <Button x:Name="PrimaryButton"
                            MinWidth="148"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Content="Download and install"
                            AutomationProperties.Name="Download and install update" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
