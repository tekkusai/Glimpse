<Window x:Class="SpacePreview.Services.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Style="{StaticResource DialogWindow}"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False">
    <StackPanel Margin="24,0,24,22">
        <Grid x:Name="TitleBar" Height="60" Background="Transparent">
            <TextBlock x:Name="TitleText"
                       FontSize="{x:Static u:Metrics.FontTitle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,-12,0"
                    Style="{StaticResource IconButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    AutomationProperties.Name="Close update" />
        </Grid>

        <TextBlock x:Name="VersionText"
                   FontSize="{x:Static u:Metrics.FontName}"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="BodyText"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource Theme.TextSecondary}"
                   FontSize="{x:Static u:Metrics.FontBody}"
                   LineHeight="19"
                   TextWrapping="Wrap" />

        <ProgressBar x:Name="DownloadProgress"
                     Height="4"
                     Margin="0,18,0,0"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed"
                     Foreground="{DynamicResource Theme.Accent}"
                     Background="{DynamicResource Theme.RaisedBg}"
                     AutomationProperties.Name="Update download progress"
                     BorderThickness="0" />
        <TextBlock x:Name="StatusText"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource Theme.TextTertiary}"
                   FontSize="{x:Static u:Metrics.FontCaption}"
                   AutomationProperties.LiveSetting="Polite"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="SecondaryButton"
                    MinWidth="88"
                    Padding="16,0"
                    Style="{StaticResource Pill}"
                    Content="Not now"
                    AutomationProperties.Name="Not now" />
            <Button x:Name="PrimaryButton"
                    MinWidth="148"
                    Margin="8,0,0,0"
                    Padding="16,0"
                    IsDefault="True"
                    Style="{StaticResource AccentPill}"
                    Content="Download and install"
                    AutomationProperties.Name="Download and install update" />
        </StackPanel>
    </StackPanel>
</Window>
