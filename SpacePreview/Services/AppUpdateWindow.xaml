<Window x:Class="SpacePreview.Services.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Title="Update Glimpse"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.SurfaceBorder}" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{x:Static u:Metrics.MenuCorner}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="Opacity"
                                        Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="Opacity"
                                        Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryUpdateButton"
               TargetType="Button"
               BasedOn="{StaticResource UpdateButton}">
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{DynamicResource Theme.HeaderBg}"
                BorderBrush="{DynamicResource Theme.SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="{x:Static u:Metrics.CardCorner}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.34"
                                  Color="#000000" />
            </Border.Effect>

            <Grid Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Update Glimpse"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="12,-6,-8,0"
                            VerticalAlignment="Top"
                            ToolTip="Close"
                            AutomationProperties.Name="Close update"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Theme.TextSecondary}"
                            FontSize="19"
                            Content="×">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseChrome"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{x:Static u:Metrics.MenuCorner}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,-2,0,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseChrome"
                                                Property="Background"
                                                Value="{DynamicResource Theme.HoverBg}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseChrome"
                                                Property="Background"
                                                Value="{DynamicResource Theme.PressedBg}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="VersionText"
                           Grid.Row="1"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource Theme.TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="BodyText"
                           Grid.Row="2"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           FontSize="13"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Text="Glimpse will download and verify the update, then close briefly while setup finishes." />

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="5"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"
                                 Foreground="{DynamicResource Theme.Accent}"
                                 Background="{DynamicResource Theme.SurfaceBg}"
                                 AutomationProperties.Name="Update download progress"
                                 BorderThickness="0" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               FontSize="11.5"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="SecondaryButton"
                            MinWidth="88"
                            Style="{StaticResource UpdateButton}"
                            Content="Not now"
                            AutomationProperties.Name="Not now" />
                    <Button x:Name="PrimaryButton"
                            MinWidth="148"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Style="{StaticResource PrimaryUpdateButton}"
                            Content="Download and install"
                            AutomationProperties.Name="Download and install update" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
