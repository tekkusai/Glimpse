<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Glimpse.ico</ApplicationIcon>
    <AssemblyName>Glimpse</AssemblyName>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Glimpse</Product>
    <Company>Glimpse</Company>
    <Description>Quick Look-style previews for Windows. Select a file, press Space.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" GeneratePathProperty="true" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Markdig" Version="0.42.0" />
    <PackageReference Include="Onigwrap" Version="1.0.11" GeneratePathProperty="true" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgOnigwrap)\runtimes\win-x64\native\libonigwrap.dll"
          Link="libonigwrap.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(PkgOnigwrap)\runtimes\win-x64\native\libonigwrap.dll')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt"
          Link="THIRD-PARTY\Microsoft.Web.WebView2-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(PkgMicrosoft_Web_WebView2)\LICENSE.txt')" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt"
          Link="THIRD-PARTY\Microsoft.Web.WebView2-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(PkgMicrosoft_Web_WebView2)\NOTICE.txt')" />
    <None Include="$(PkgOnigwrap)\THIRD-PARTY-NOTICES.TXT"
          Link="THIRD-PARTY\Onigwrap-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(PkgOnigwrap)\THIRD-PARTY-NOTICES.TXT')" />
  </ItemGroup>
</Project>
