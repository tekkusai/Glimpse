<Window x:Class="SpacePreview.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpacePreview.Utilities"
        Title="{x:Static u:Branding.Name}"
        Width="900" Height="650"
        MinWidth="640" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.CanvasBg}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="RootChrome"
            Background="{DynamicResource Theme.CanvasBg}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- docs/DESIGN.md, Header. Left to right: browse, identity,
                 the kind's tools, Open, the window's own buttons. Only the
                 identity column stretches; below the name's floor the
                 optional lanes step aside instead (IdentityPanel_SizeChanged). -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="{DynamicResource Theme.ChromeBg}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The arrows change WHICH file, so they sit before its
                         identity; a multi-selection shows its place beside them. -->
                    <StackPanel x:Name="BrowseControls"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Visibility="Collapsed">
                        <Button x:Name="BrowsePreviousButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76B;"
                                Click="BrowsePreviousButton_Click"
                                AutomationProperties.Name="Previous item"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Previous item (Left arrow)" />
                        <Button x:Name="BrowseNextButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76C;"
                                Click="BrowseNextButton_Click"
                                AutomationProperties.Name="Next item"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Next item (Right arrow)" />
                        <TextBlock x:Name="SelectionPositionText"
                                   Margin="4,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="{x:Static u:Metrics.FontCaption}"
                                   Foreground="{DynamicResource Theme.TextTertiary}"
                                   Visibility="Collapsed" />
                        <Button x:Name="GridButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xF0E2;"
                                Click="GridButton_Click"
                                AutomationProperties.Name="All selected items"
                                Visibility="Collapsed"
                                ToolTip="All selected items (Ctrl+Enter)" />
                        <Button x:Name="PlayButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE768;"
                                Click="PlayButton_Click"
                                AutomationProperties.Name="Slideshow"
                                Visibility="Collapsed"
                                ToolTip="Slideshow" />
                    </StackPanel>

                    <Image x:Name="FileIconImage"
                           Grid.Column="1"
                           Width="22"
                           Height="22"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Visibility="Hidden"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel x:Name="IdentityPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                SizeChanged="IdentityPanel_SizeChanged">
                        <TextBlock x:Name="FileNameText"
                                   FontSize="{x:Static u:Metrics.FontName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,1,0,0"
                                   FontSize="{x:Static u:Metrics.FontCaption}"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Tools belong to the file's kind: chosen when the item
                         opens and inert until its content binds, so browsing
                         one kind never moves them. No kind, no slot. -->
                    <Grid x:Name="ContentToolsSlot"
                          Grid.Column="3"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Border x:Name="ZoomControls" Style="{StaticResource PillFrame}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ZoomOutButton"
                                        Style="{StaticResource PillGlyphSegment}"
                                        Content="&#xE738;"
                                        AutomationProperties.Name="Zoom out"
                                        ToolTip="Zoom out (Ctrl+Minus)" />
                                <Button x:Name="ZoomResetButton"
                                        Style="{StaticResource PillSegment}"
                                        Width="52"
                                        Padding="0"
                                        Content="100%"
                                        AutomationProperties.Name="Reset zoom"
                                        ToolTip="Reset zoom (Ctrl+0)" />
                                <Button x:Name="ZoomInButton"
                                        Style="{StaticResource PillGlyphSegment}"
                                        Content="&#xE710;"
                                        AutomationProperties.Name="Zoom in"
                                        ToolTip="Zoom in (Ctrl+Plus)" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ContentActions" Style="{StaticResource PillFrame}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <!-- One Fluent rotate glyph, mirrored for the
                                     other way: the pair stays in the icon family. -->
                                <Button x:Name="RotateLeftButton"
                                        Style="{StaticResource PillGlyphSegment}"
                                        Click="RotateLeftButton_Click"
                                        AutomationProperties.Name="Rotate left"
                                        ToolTip="Rotate left (Ctrl+Shift+R)">
                                    <TextBlock Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="-1" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="RotateRightButton"
                                        Style="{StaticResource PillGlyphSegment}"
                                        Content="&#xE7AD;"
                                        Click="RotateRightButton_Click"
                                        AutomationProperties.Name="Rotate right"
                                        ToolTip="Rotate right (Ctrl+R)" />
                            </StackPanel>
                        </Border>

                        <!-- Work kept from last time turns Sign into Resume;
                             the pen says what is resumed. Both labels are
                             laid out, so the pill keeps one width for every
                             PDF, short enough to stay at the smallest stage. -->
                        <Button x:Name="SignButton"
                                Style="{StaticResource Pill}"
                                Visibility="Collapsed"
                                Click="SignButton_Click"
                                AutomationProperties.Name="Fill and sign"
                                ToolTip="Fill and sign">
                            <Grid>
                                <StackPanel x:Name="SignLabel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE70F;"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               FontWeight="Normal" />
                                    <TextBlock Text="Sign" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="ResumeLabel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Visibility="Hidden">
                                    <TextBlock Text="&#xE70F;"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               FontWeight="Normal" />
                                    <TextBlock Text="Resume" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Open: the default app's icon, the word and a chevron
                         for the other ways. The other label is laid out
                         hidden, so the pill keeps one width for every file. -->
                    <Border x:Name="OpenControl"
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            Style="{StaticResource PillFrame}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenButton"
                                    Style="{StaticResource PillSegment}"
                                    Padding="6,0"
                                    Click="OpenButton_Click"
                                    AutomationProperties.Name="Open"
                                    ToolTip="Open (Enter)">
                                <Grid>
                                    <StackPanel x:Name="OpenInAppLabel"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Image x:Name="OpenAppIcon"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Open" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="OpenWithLabel"
                                               Text="Open with&#x2026;"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Hidden" />
                                </Grid>
                            </Button>
                            <Border Width="1"
                                    Margin="0,8,0,8"
                                    Background="{DynamicResource Theme.RaisedBorder}" />
                            <Button x:Name="OpenMenuButton"
                                    Style="{StaticResource PillGlyphSegment}"
                                    Width="28"
                                    FontSize="10"
                                    Content="&#xE70D;"
                                    Click="OpenMenuButton_Click"
                                    AutomationProperties.Name="More ways to open"
                                    ToolTip="More ways to open" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="WindowActions"
                                Grid.Column="5"
                                Margin="8,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- The icon font has no topmost symbol, and a second
                             pin beside Unpin would lie: two windows, the
                             raised one solid. -->
                        <ToggleButton x:Name="AlwaysOnTopButton"
                                      Style="{StaticResource IconToggleButton}"
                                      Visibility="Collapsed"
                                      Opacity="0"
                                      IsChecked="True"
                                      Checked="AlwaysOnTopButton_CheckedChanged"
                                      Unchecked="AlwaysOnTopButton_CheckedChanged"
                                      AutomationProperties.Name="Always on top"
                                      ToolTip="Always on top">
                            <Grid Width="12" Height="12">
                                <Rectangle Width="8"
                                           Height="8"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           StrokeThickness="1"
                                           RadiusX="1.5"
                                           RadiusY="1.5" />
                                <Rectangle Width="8"
                                           Height="8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           RadiusX="1.5"
                                           RadiusY="1.5" />
                            </Grid>
                        </ToggleButton>
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE718;"
                                Click="PinButton_Click"
                                AutomationProperties.Name="Pin preview"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Pin (stays open)" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE922;"
                                Click="MaximizeButton_Click"
                                AutomationProperties.Name="Fill screen"
                                ToolTip="Fill screen (F11)" />
                        <Button x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8BB;"
                                Click="CloseButton_Click"
                                AutomationProperties.Name="Close preview"
                                ToolTip="Close (Esc or Space)" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- The item making way for the next: it fades out, or waits
                     under the next one while that dissolves over it. -->
                <ContentControl x:Name="OutgoingContent" IsHitTestVisible="False" />
                <!-- The best image of content that is not ready yet. -->
                <ContentControl x:Name="StandInLayer" IsHitTestVisible="False" Visibility="Collapsed" />
                <ContentControl x:Name="PreviewContent" />
                <!-- A browser view starting its engine while the old item leaves. -->
                <ContentControl x:Name="IncomingContent" IsHitTestVisible="False" Visibility="Hidden" />
            </Grid>
        </Grid>
    </Border>
</Window>
